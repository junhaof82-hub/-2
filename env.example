# ===== Required? No. The app starts without paid API keys. =====

# Market / fundamentals / news providers
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=

# Optional LLM news classification
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# SEC asks automated clients to identify themselves. Example:
# SEC_USER_AGENT=StockAIMAX your-email@example.com
SEC_USER_AGENT=

# Runtime tuning
REQUEST_TIMEOUT=15
MAX_RETRIES=3
CACHE_TTL_SECONDS=900
NEWS_LOOKBACK_HOURS=168
NEWS_MAX_ITEMS=40
TRAIN_PERIOD=5y
MODEL_VERSION=max-v2.0
MONTE_CARLO_SIMULATIONS=30000
RANDOM_SEED=42

# Cloud stability defaults
CLOUD_SAFE_MODE=1
FULL_MODEL_MODE=0
ENABLE_OPTIONS=0
ENABLE_FRED_WITHOUT_KEY=0
TRAIN_PERIOD=3y
MONTE_CARLO_SIMULATIONS=5000
REQUEST_TIMEOUT=8
MAX_RETRIES=1
